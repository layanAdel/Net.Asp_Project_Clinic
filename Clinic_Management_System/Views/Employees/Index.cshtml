@model IEnumerable<Employee>

<div class="container">

    <h1>Employees</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary"> New Employee</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Position</th>
                <th>Phone</th>
                <th>Email</th>
                <th>HireDate</th>
                <th>Salary</th>
            </tr>

        </thead>

        <tbody>
            @foreach (var emp in Model)
            {
                <tr>

                    <td>@emp.Id</td>
                    <td>@emp.FirstName</td>
                    <td>@emp.LastName</td>
                    <td>@emp.Position</td>
                    <td>@emp.Phone</td>
                    <td>@emp.Email</td>
                    <td>@emp.HireDate</td>
                    <td>@emp.Salary</td>

                    <td>

                        <a asp-action="Edit" asp-route-Id="@emp.Id" class="btn btn-warning"> Edit </a>
                        <a asp-action="Delete" asp-route-Id="@emp.Id" class="btn btn-danger"> Delete </a>

                    </td>

                </tr>
            }
        </tbody>

    </table>

</div>