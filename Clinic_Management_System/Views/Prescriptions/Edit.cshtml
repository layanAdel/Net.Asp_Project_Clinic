@model Prescription
@{
    ViewData["Title"] = "Edit Prescription";

}

<div class="container">
    <h1>Edit Prescriptions</h1>
    <form asp-action="Edit" method="post">

        <div class="text-danger" asp-validation-summary="All">
        </div>

        <div class="form-group">
            <label asp-for="FirstName" class="control-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span class="text-danger" asp-validation-for="FirstName"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName" class="control-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span class="text-danger" asp-validation-for="LastName"></span>
        </div>

        
        <div class="form-group">
            <label asp-for="DoctorFirstName" class="control-label"></label>
            <input asp-for="DoctorFirstName" class="form-control" />
            <span class="text-danger" asp-validation-for="DoctorFirstName"></span>
        </div>

        
        <div class="form-group">
            <label asp-for="DoctorLastName" class="control-label"></label>
            <input asp-for="DoctorLastName" class="form-control" />
            <span class="text-danger" asp-validation-for="DoctorLastName"></span>
        </div>

        
        <div class="form-group">
            <label asp-for="Medication" class="control-label"></label>
            <input asp-for="Medication" class="form-control" />
            <span class="text-danger" asp-validation-for="Medication"></span>
        </div>

        
        <div class="form-group">
            <label asp-for="Dosage" class="control-label"></label>
            <input asp-for="Dosage" class="form-control" />
            <span class="text-danger" asp-validation-for="Dosage"></span>
        </div>

        <div class="form-group">
            <label asp-for="Instructions" class="control-label"></label>
            <input asp-for="Instructions" class="form-control" />
            <span class="text-danger" asp-validation-for="Instructions"></span>
        </div>

        <div class="form-group">
            <label asp-for="PrescriptionDate" class="control-label"></label>
            <input asp-for="PrescriptionDate" class="form-control" />
            <span class="text-danger" asp-validation-for="PrescriptionDate"></span>
        </div>



        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-warning mt-3" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}